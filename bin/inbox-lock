#!/usr/bin/env python3
"""inbox-lock acquire <inbox file> | inbox-lock release <inbox file> <token>

The office inbox's lock (office/inboxfile.py) for cc-mods, whose $.fs has no
exclusive create: coord.ts and register.ts hold it around their own read and
write of an inbox file, and around the taker's rename, the way office.py and
bin/coord-report do in-process. `acquire` prints the token `release` needs;
the lock outlives this process until released, or until it goes stale when
the module that took it reloaded mid-hold. Only files directly under
~/.claude/state/office/inbox are locked.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "office"))
import inboxfile  # noqa: E402 - office/inboxfile.py


def _inbox_file(p: str) -> str | None:
    p = os.path.abspath(p)
    if os.path.realpath(os.path.dirname(p)) != os.path.realpath(inboxfile.folder()):
        return None
    sid, _, ext = os.path.basename(p).partition(".")
    return p if ext == "json" and inboxfile.SID.match(sid) else None


def main(argv: list[str]) -> int:
    path = _inbox_file(argv[2]) if len(argv) >= 3 else None
    if not path or argv[1] not in ("acquire", "release") or (argv[1] == "release") != (len(argv) == 4):
        print("usage: inbox-lock acquire <inbox file> | inbox-lock release <inbox file> <token>", file=sys.stderr)
        return 2
    if argv[1] == "acquire":
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            print(inboxfile.acquire(path))
        except TimeoutError as e:
            print(str(e), file=sys.stderr)
            return 1
        return 0
    inboxfile.release(path, argv[3])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
